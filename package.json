{
  "name": "minebench",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "env:ensure": "node scripts/ensure-env.mjs",
    "env:localdb": "node scripts/prepare-local-env.mjs",
    "prelocal:dev": "pnpm env:localdb",
    "prelocal:db:refresh": "pnpm env:localdb",
    "prelocal:prisma:migrate": "pnpm env:localdb",
    "db:wait": "node scripts/wait-for-db.mjs",
    "dev:setup": "pnpm env:ensure && pnpm atlas && pnpm db:reset && pnpm db:wait && pnpm prisma:migrate && pnpm dev",
    "dev": "next dev",
    "local:dev": "node scripts/with-local-env.mjs next dev",
    "local:db:refresh": "node scripts/refresh-local-db-from-remote.mjs",
    "local:prisma:migrate": "node scripts/with-local-env.mjs prisma migrate deploy",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "pretest": "prisma generate",
    "test": "tsx tests/run.ts",
    "test:unit": "tsx tests/run.ts tests/unit",
    "test:config": "tsx tests/run.ts tests/config",
    "pretest:integration": "prisma generate",
    "test:integration": "node scripts/run-postgres-tests.mjs tests/integration",
    "check": "pnpm lint && pnpm test && pnpm build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "atlas": "node scripts/build-texture-atlas.mjs",
    "dsl:prompt": "tsx scripts/build-dsl-prompt.ts",
    "catalogue:build": "tsx scripts/build-block-catalogue.ts",
    "recipes:groups": "tsx scripts/extract-recipe-groups.ts",
    "atlas:audit": "node scripts/audit-texture-pack.mjs",
    "generations:worker": "tsx scripts/custom-build-worker.ts",
    "generations:artifacts:audit": "tsx scripts/audit-saved-generation-artifacts.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1119.0",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^6.0.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@vercel/analytics": "^1.6.1",
    "@vercel/functions": "^3.9.5",
    "@vercel/oidc-aws-credentials-provider": "^3.3.5",
    "@vercel/otel": "^2.1.3",
    "@vercel/speed-insights": "^2.0.0",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "gifsicle-wasm-browser": "^1.5.19",
    "mediabunny": "1.55.3",
    "next": "^15.0.0",
    "nodemailer": "^9.0.5",
    "obscenity": "0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.1",
    "dotenv": "^16.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "prisma": "^6.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
