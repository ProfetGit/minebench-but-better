generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String    @id @db.Uuid
  email                    String    @unique
  displayName              String?
  publicNickname           String?   @db.VarChar(40)
  publicNicknameNormalized String?   @unique @db.VarChar(40)
  lastSeenAt               DateTime?
  isMineBenchAdmin         Boolean   @default(false)
  totalGenerationCount     Int       @default(0)
  hostedGenerationCount    Int       @default(0)
  hostedGenerationLimit    Int       @default(100)
  deletedAt                DateTime?
  authDeletedAt            DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  customBuilds            CustomBuild[]
  publicSessionActivities PublicSessionActivity[]

  @@index([deletedAt, authDeletedAt])
}

enum CustomBuildStatus {
  queued
  running
  succeeded
  failed
  canceled
}

enum CustomBuildJobType {
  generate
  export
}

enum CustomBuildJobStatus {
  queued
  running
  succeeded
  failed
  canceled
}

enum CustomBuildArtifactKind {
  build_json
  preview_json
  raw_text_debug
  glb
  stl
  schem
  preview_mbv4
  viewer_mbv4
  viewer_mbf1
  preview_svg
}

enum CustomBuildStorageEncoding {
  identity
  gzip
}

model CustomBuild {
  id                String    @id @default(cuid())
  publicId          String    @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  startedAt         DateTime?
  completedAt       DateTime?
  removedAt         DateTime?
  purgeAt           DateTime?
  objectsDeletedAt  DateTime?
  deletionPendingAt DateTime?
  deletionError     String?

  ownerId String? @db.Uuid
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  status       CustomBuildStatus @default(queued)
  currentStage String?
  progress     Json?

  promptText     String
  promptSha256   String
  gridSize       Int
  palette        String
  mode           String @default("precise")
  generationMode String @default("tool")

  modelKind            String
  modelKey             String?
  modelProvider        String
  modelId              String
  modelDisplayName     String
  openRouterModelId    String?
  legacyCustomBaseUrl  String? @map("customBaseUrl") @ignore
  preferOpenRouter     Boolean @default(false)
  usesHostedGeneration Boolean @default(false)
  reasoning            String?

  blockCount       Int?
  generationTimeMs Int?
  warnings         Json?
  metrics          Json?

  buildSha256             String?
  buildByteSize           Int?
  buildCompressedByteSize Int?
  previewBlockCount       Int?
  previewSha256           String?
  storedByteSize          Int     @default(0)

  errorCode      String?
  errorMessage   String?
  errorRetryable Boolean?

  requestedIpHash        String?
  requestedUserAgentHash String?

  jobs      CustomBuildJob[]
  artifacts CustomBuildArtifact[]
  events    CustomBuildEvent[]
  secret    CustomBuildSecret?

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([ownerId, removedAt, status, createdAt])
  @@index([ownerId, deletionPendingAt])
  @@index([promptSha256])
  @@index([modelProvider, modelId])
}

model CustomBuildSecret {
  id            String      @id @default(cuid())
  customBuildId String      @unique
  customBuild   CustomBuild @relation(fields: [customBuildId], references: [id], onDelete: Cascade)

  provider           String
  keyCiphertext      String
  keyIv              String
  keyAuthTag         String?
  endpointCiphertext String?
  endpointIv         String?
  endpointAuthTag    String?
  keyVersion         Int       @default(1)
  expiresAt          DateTime
  consumedAt         DateTime?
  deletedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model CustomBuildJob {
  id            String      @id @default(cuid())
  customBuildId String
  customBuild   CustomBuild @relation(fields: [customBuildId], references: [id], onDelete: Cascade)

  type     CustomBuildJobType
  status   CustomBuildJobStatus @default(queued)
  payload  Json?
  priority Int                  @default(0)

  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  runAfter    DateTime @default(now())

  lockedBy       String?
  lockedAt       DateTime?
  leaseExpiresAt DateTime?

  startedAt        DateTime?
  completedAt      DateTime?
  lastErrorCode    String?
  lastErrorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAfter, priority, createdAt])
  @@index([leaseExpiresAt])
  @@index([customBuildId, type, status])
}

model CustomBuildArtifact {
  id            String      @id @default(cuid())
  customBuildId String
  customBuild   CustomBuild @relation(fields: [customBuildId], references: [id], onDelete: Cascade)

  kind        CustomBuildArtifactKind
  format      String
  bucket      String
  path        String
  encoding    CustomBuildStorageEncoding @default(identity)
  contentType String
  fileName    String

  sha256             String
  sourceBuildSha256  String?
  byteSize           Int
  compressedByteSize Int?
  storedByteSize     Int
  blockCount         Int?
  exportStats        Json?

  createdAt DateTime @default(now())

  @@unique([customBuildId, kind, sourceBuildSha256])
  @@index([customBuildId, kind])
  @@index([sha256])
}

model CustomBuildEvent {
  id            String      @id @default(cuid())
  customBuildId String
  customBuild   CustomBuild @relation(fields: [customBuildId], references: [id], onDelete: Cascade)

  seq       Int
  type      String
  data      Json?
  createdAt DateTime @default(now())

  @@unique([customBuildId, seq])
  @@index([customBuildId, createdAt])
}

model CustomBuildStatsDaily {
  day              DateTime @id
  created          Int      @default(0)
  succeeded        Int      @default(0)
  failed           Int      @default(0)
  canceled         Int      @default(0)
  exportsRequested Int      @default(0)
  exportsSucceeded Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PublicSessionActivity {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  userId        String?  @db.Uuid
  lastSeenAt    DateTime @default(now())
  city          String?  @db.VarChar(160)
  countryRegion String?  @db.VarChar(64)
  country       String?  @db.VarChar(8)
  ipHmac        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([lastSeenAt])
  @@index([userId, lastSeenAt])
  @@index([ipHmac, lastSeenAt])
}
